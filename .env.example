# Public origin of the deployed site, no trailing slash.
# Drives <link rel="canonical">, Open Graph URLs, sitemap.xml, robots.txt and the JSON-LD "url".
NEXT_PUBLIC_SITE_URL=https://www.dharshinilaboratory.com

# Optional: site-ownership tokens from Google Search Console / Bing Webmaster Tools.
# Leave empty to omit the <meta> tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
